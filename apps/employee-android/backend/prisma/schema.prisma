datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleType {
  SUPER_ADMIN
  SUB_ADMIN
  EMPLOYEE
}

enum AttendanceStatus {
  ACTIVE
  COMPLETED
  DISCREPANCY_FLAGGED
}

enum EntryStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TransactionType {
  ALLOCATION_CREDIT
  WITHDRAWAL_APPROVED
  PENDING_RESERVATION
  RESERVATION_RELEASED
  ADJUSTMENT
}

model User {
  id              String            @id @default(uuid())
  email           String            @unique
  passwordHash    String
  role            RoleType          @default(EMPLOYEE)
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  employeeProfile EmployeeProfile?
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  adminAssignments AdminAssignment[] @relation("AdminToSubAdmin")
  supervisedAssignments AdminAssignment[] @relation("SubAdminToEmployee")
}

model Role {
  id              String            @id @default(uuid())
  name            RoleType          @unique
  description     String?
  permissions     RolePermission[]
}

model Permission {
  id              String            @id @default(uuid())
  action          String            @unique // e.g. "entries:approve", "finance:allocate"
  description     String?
  roles           RolePermission[]
}

model RolePermission {
  roleId          String
  permissionId    String

  role            Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission      Permission        @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model EmployeeProfile {
  id              String            @id @default(uuid())
  userId          String            @unique
  employeeId      String            @unique
  fullName        String
  phoneNumber     String?
  accountStatus   String            @default("ACTIVE")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendances     Attendance[]
  entries         EmployeeEntry[]
  allocations     Allocation[]
  transactions    FinancialTransaction[]
  activities      EmployeeActivity[]
}

model AdminAssignment {
  id              String            @id @default(uuid())
  adminId         String
  employeeId      String
  assignedAt      DateTime          @default(now())

  admin           User              @relation("AdminToSubAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  employee        User              @relation("SubAdminToEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([adminId, employeeId])
}

model Attendance {
  id                  String            @id @default(uuid())
  employeeProfileId   String
  checkInTime         DateTime          @default(now())
  checkInLatitude     Decimal           @db.Decimal(10, 7)
  checkInLongitude    Decimal           @db.Decimal(10, 7)
  checkInAccuracy     Decimal           @db.Decimal(6, 2)
  checkOutTime        DateTime?
  checkOutLatitude    Decimal?          @db.Decimal(10, 7)
  checkOutLongitude   Decimal?          @db.Decimal(10, 7)
  checkOutAccuracy    Decimal?          @db.Decimal(6, 2)
  durationMinutes     Int               @default(0)
  status              AttendanceStatus  @default(ACTIVE)
  remarks             String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  employeeProfile     EmployeeProfile   @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([employeeProfileId, status])
}

model EmployeeEntry {
  id                      String            @id @default(uuid())
  employeeProfileId       String
  websiteUrl              String
  encryptedBankAccount    String            // Encrypted ciphertext
  bankAccountMasked       String            // e.g. "•••• •••• 4892"
  referenceId             String            @unique
  amount                  Decimal           @db.Decimal(12, 2)
  withdrawalAmount        Decimal           @db.Decimal(12, 2)
  status                  EntryStatus       @default(PENDING)
  adminRemarks            String?
  rejectionReason         String?
  reviewedByAdminId       String?
  reviewedAt              DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  employeeProfile         EmployeeProfile   @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  revisions               EntryRevision[]
  files                   EntryFile[]

  @@index([employeeProfileId, status])
  @@index([referenceId])
}

model EntryRevision {
  id              String            @id @default(uuid())
  entryId         String
  modifiedBy      String
  changesJson     Json
  revisionReason  String?
  createdAt       DateTime          @default(now())

  entry           EmployeeEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model EntryFile {
  id              String            @id @default(uuid())
  entryId         String
  s3Key           String
  s3Bucket        String
  fileName        String
  mimeType        String
  fileSize        BigInt
  createdAt       DateTime          @default(now())

  entry           EmployeeEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
}

model Allocation {
  id                  String            @id @default(uuid())
  employeeProfileId   String
  amount              Decimal           @db.Decimal(12, 2)
  approvedByAdminId   String
  allocatedAt         DateTime          @default(now())
  notes               String?

  employeeProfile     EmployeeProfile   @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
}

model FinancialTransaction {
  id                  String            @id @default(uuid())
  employeeProfileId   String
  referenceId         String
  type                TransactionType
  amount              Decimal           @db.Decimal(12, 2)
  balanceAfter        Decimal           @db.Decimal(12, 2)
  status              String            @default("SETTLED")
  description         String
  createdAt           DateTime          @default(now())

  employeeProfile     EmployeeProfile   @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)

  @@index([employeeProfileId, createdAt])
}

model Alert {
  id              String            @id @default(uuid())
  severity        String            // LOW, MEDIUM, CRITICAL
  title           String
  message         String
  sourceModule    String
  resolved        Boolean           @default(false)
  createdAt       DateTime          @default(now())
}

model Notification {
  id              String            @id @default(uuid())
  userId          String
  title           String
  body            String
  isRead          Boolean           @default(false)
  createdAt       DateTime          @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id              String            @id @default(uuid())
  userId          String
  tokenHash       String            @unique
  expiresAt       DateTime
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id              String            @id @default(uuid())
  userId          String?
  action          String
  resource        String
  payload         Json?
  ipAddress       String?
  userAgent       String?
  createdAt       DateTime          @default(now())

  user            User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model EmployeeActivity {
  id                  String            @id @default(uuid())
  employeeProfileId   String
  activityType        String
  description         String
  metadata            Json?
  createdAt           DateTime          @default(now())

  employeeProfile     EmployeeProfile   @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
}
